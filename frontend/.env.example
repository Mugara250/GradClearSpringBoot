# Where the Spring Boot backend runs. Used by the dev proxy (vite.config.ts)
# and for the "Sign in with Google" link, which is a full-page navigation
# straight to the backend (not proxied).
VITE_BACKEND_URL=http://localhost:8088

# Prefix for API calls. Leave empty in dev (requests go to /api/... on the
# Vite server and are proxied). For a production build behind a different
# origin, set it to the backend URL, e.g. https://api.gradclear.example
VITE_API_BASE_URL=
